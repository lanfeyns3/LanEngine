  "vertexShaderCode": "#version 460 core\n\nlayout(location=0) in vec3 position;\nlayout(location=1) in vec3 normal;\n\nuniform mat4 model;\nuniform mat4 view;\nuniform mat4 projection;\n\nout vec3 fragNormal;\nout vec3 fragWorldPosition;\n\nvoid main()\n{\n    fragNormal = mat3(transpose(inverse(model))) * normal;\n\n    fragWorldPosition = vec3(model * vec4(position, 1.0));\n\n    gl_Position = projection * view * model * vec4(position, 1.0);\n}",
  "fragmentShaderCode": "#version 460 core\n\nlayout(location = 0) out vec4 outColor;\n\nin vec3 fragNormal;\nin vec3 fragWorldPosition;\n\nstruct GPULight\n{\n    vec3 position;\n    float radius;\n\n    vec3 color;\n    float intensity;\n};\n\nlayout(std140, binding = 0) uniform LightUBO\n{\n    GPULight light;\n};\n\nvoid main()\n{\n    vec3 normal = normalize(fragNormal);\n\n    vec3 toLight = light.position - fragWorldPosition;\n\n    float distanceToLight = length(toLight);\n\n    vec3 lightDirection = normalize(toLight);\n\n    float diffuse = max(dot(normal, lightDirection), 0.0);\n\n    float attenuation = 1.0 - smoothstep(\n        0.0,\n        light.radius,\n        distanceToLight\n    );\n\n    vec3 finalColor =\n        light.color *\n        light.intensity *\n        diffuse *\n        attenuation;\n\n    outColor = vec4(finalColor, 1.0);\n}"
}
